# Copy to .env and fill in. .env is gitignored — never commit real keys.
#
# LLM gateway used by research tooling only (summarisation, extraction assists).
# No teardown *claim* may originate from a model: see README "Evidence rules".
LLM_BASE_URL=https://freellm.kaapibyte.com/v1
LLM_API_KEY=

# Endpoints exposed by this gateway:
#   /chat/completions   OpenAI-compatible
#   /responses          OpenAI Responses API
#   /messages           Anthropic-compatible (Claude)
#   /embeddings         model: "auto" or an embedding family

# Model id. "auto" lets the gateway route.
LLM_MODEL=auto
LLM_EMBED_MODEL=auto
